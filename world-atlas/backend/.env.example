# Database
DATABASE_URL=postgresql://atlas:atlas_password@localhost:5432/world_atlas

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Provider (optional - leave empty for mock/no AI)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
