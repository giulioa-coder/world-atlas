# Database
# For SQLite (development):
DATABASE_URL=sqlite:///./world_atlas.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/world_atlas

# Security - CHANGE IN PRODUCTION!
SECRET_KEY=change-this-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload
MAX_FILE_SIZE_MB=50

# Redis (optional, for future Celery integration)
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
